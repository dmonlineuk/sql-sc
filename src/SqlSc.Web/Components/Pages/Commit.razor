@page "/commit"
@inherits WorkPage

<PageTitle>sql-sc - Commit</PageTitle>

@if (State.CurrentLink is not { } link)
{
    <section class="card"><p>Link a working folder to a database on <a href="">Setup</a> first.</p></section>
}
else
{
    <section class="card">
        <div class="row" style="margin-top:0">
            <button id="refresh" class="primary" @onclick="Refresh" disabled="@Busy">Refresh</button>
            <GitBar Git="Git" Branches="Branches" Stashes="Stashes" Busy="Busy" OnGit="RunGit" BlockedSwitch="@BlockedSwitch" OnBranch="ChangeBranch" OnCancelSwitch="CancelSwitch" OnStash="ChangeStash" />
            @if (Busy)
            {
                <span class="muted">@BusyText</span>
            }
        </div>
        @if (PasswordNeeded)
        {
            <PasswordPrompt Link="State.CurrentLink!" Busy="Busy" OnConnected="Refresh" />
        }
        @if (Notice is not null)
        {
            <p class="@(Failed ? "error" : "ok")">@Notice</p>
        }
    </section>

    @if (result is { } r)
    {
        <div class="stacked">
            <section class="card">
                <h2>@rows.Count changes in @r.Status.Database on @r.Status.Server</h2>
                @if (rows.Count == 0)
                {
                    <p class="muted">The database and the folder match.</p>
                }
                else
                {
                    <div class="table-scroll changes">
                    <table class="grid">
                        <thead>
                            <tr>
                                <th><input type="checkbox" checked="@(rows.All(x => x.Selected))" @onchange="e => SelectAll(e.Value is true)" title="Select all" /></th>
                                <th>Type</th><th>Object</th><th>Change</th><th>Changed in</th><th>Changed by</th><th>Locked by</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr class="@(row == current ? "selected" : null)" @onclick="() => current = row">
                                    <td @onclick:stopPropagation="true"><input type="checkbox" @bind="row.Selected" /></td>
                                    <td>@row.Type</td>
                                    <td>@row.Name</td>
                                    <td>@row.Change</td>
                                    <td class="@(row.Side is ChangeSide.Folder or ChangeSide.Both ? "warn" : null)">@SideText(row.Side)</td>
                                    <td>@row.ChangedBy</td>
                                    <td class="@(LockOn(row.Name) is { Mine: false } ? "warn" : null)">@LockText(row.Name)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                @foreach (var problem in r.Problems)
                {
                    <p class="error">@problem</p>
                }
                @if (rows.Any(x => x.Selected && x.Side is ChangeSide.Folder or ChangeSide.Both))
                {
                    <p class="warn">Some selected objects changed in the folder since they last matched the database. Committing them replaces the folder's version with the database's.</p>
                }
                @if (rows.Any(x => x.Selected && LockOn(x.Name) is { Mine: false }))
                {
                    <p class="warn">Some selected objects are locked by someone else, who may still be working on them. Committing them puts their current state in git.</p>
                }
                <label for="message">Commit message</label>
                <textarea id="message" @bind="message" @bind:event="oninput"></textarea>
                <div class="row">
                    <button id="commit" class="primary" @onclick="() => CommitSelected(false)" disabled="@(!CanCommit)">Commit</button>
                    <button id="commit-push" @onclick="() => CommitSelected(true)" disabled="@(!CanCommit)">Commit &amp; Push</button>
                    <span class="muted">@rows.Count(x => x.Selected) selected</span>
                </div>
            </section>
            <section class="card">
                @if (current is null)
                {
                    <p class="muted">Select a change to see its script.</p>
                }
                else
                {
                    <h2>@current.Name</h2>
                    @if (current.SettingsDiff is { } settingsDiff)
                    {
                        <p class="muted">A working folder settings file, changed since the last commit. Commit it to share it with your team.</p>
                        <DiffView Unified="@settingsDiff" Empty="Only line endings differ." />
                    }
                    else if (!current.IsData)
                    {
                        <LockControl Name="@current.Name" Lock="LockOn(current.Name)" Busy="Busy" OnChange="ChangeLock" />
                    }
                    @if (current.Detail is { } detail)
                    {
                        <p class="muted">@detail</p>
                    }
                    @foreach (var file in FilesFor(current))
                    {
                        <p><b>@file.Path</b> <span class="muted">@(file.Action == FileAction.Deleted ? "would be deleted" : "would be written")</span></p>
                        <DiffView Unified="@file.Diff" Empty="Only line endings differ." />
                    }
                }
            </section>
        </div>
    }
}

@code {
    private ExportResult? result;
    private List<ChangeRow> rows = [];
    private ChangeRow? current;
    private string? message;

    private List<DataChange> DataRows => result?.Status.Data.Where(d => d.HasChanges).ToList() ?? [];

    private bool CanCommit => !Busy && !string.IsNullOrWhiteSpace(message) && rows.Any(x => x.Selected) && Git is not null;

    protected override async Task Refresh()
    {
        if (!Connect(out var link, out var folder, out var connection))
        {
            return;
        }

        await Run("Comparing the database with the folder...", () =>
        {
            UpdateGit(link.Folder);
            result = ExportService.Export(
                folder,
                connection,
                new ExportSelection([], All: true, Data: true, Force: true),
                dryRun: true,
                baseline: BaselineStore.Default,
                includeChangedBy: true);
            SetLocks(result.Status.Locks);
            var settingsFiles = Git is null ? [] : CommitService.SettingsChanges(folder);
            rows = [.. result.Status.Changes.Select(ChangeRow.For), .. DataRows.Select(ChangeRow.For), .. settingsFiles.Select(ChangeRow.For)];
            current = rows.FirstOrDefault();
            return Git is null ? $"{link.Folder} isn't in a git repository; Commit is unavailable." : null;
        });
    }

    private async Task CommitSelected(bool push)
    {
        if (!Connect(out var link, out var folder, out var connection))
        {
            return;
        }

        var selected = rows.Where(x => x.Selected).ToList();
        List<string> settingsFiles = [.. selected.Where(x => x.SettingsDiff is not null).Select(x => x.Name)];
        var objectsOrData = selected.Any(x => x.SettingsDiff is null);
        var selection = new ExportSelection(
            [.. selected.Where(x => !x.IsData && x.SettingsDiff is null).Select(x => x.Name)],
            Data: selected.Any(x => x.IsData),
            DataNames: [.. selected.Where(x => x.IsData).Select(x => x.Name)],
            Force: selected.Any(x => x.Side is ChangeSide.Folder or ChangeSide.Both || LockOn(x.Name) is { Mine: false }));
        var text = message!;
        await Run(push ? "Committing and pushing..." : "Committing...", () =>
        {
            var (files, commit) = (Array.Empty<string>() as IReadOnlyList<string>, (string?)null);
            if (objectsOrData)
            {
                var committed = CommitService.Commit(folder, connection, selection, text, baseline: BaselineStore.Default, settingsFiles: settingsFiles);
                if (committed.Export.Problems.Count > 0)
                {
                    throw new InvalidDataException(string.Join('\n', committed.Export.Problems));
                }

                (files, commit) = (committed.CommittedFiles, committed.Commit);
            }
            else
            {
                (files, commit) = CommitService.CommitSettings(folder, settingsFiles, text);
            }

            if (commit is null)
            {
                throw new InvalidDataException("Nothing was committed.");
            }

            var pushed = push ? GitSync.Push(link.Folder) : null;
            return $"Committed {files.Count} file(s) as {commit[..Math.Min(8, commit.Length)]}.{(push ? " Pushed." : "")}{(string.IsNullOrEmpty(pushed) ? "" : $"\n{pushed}")}";
        });
        if (!Failed)
        {
            message = null;
        }

        await RefreshAfter();
    }

    private void SelectAll(bool selected) => rows.ForEach(x => x.Selected = selected);

    private IEnumerable<ExportedFile> FilesFor(ChangeRow row) =>
        result?.Files.Where(f => row.IsData
            ? string.Equals(f.Path, row.File, StringComparison.OrdinalIgnoreCase)
            : f.Objects.Contains(row.Name, StringComparer.OrdinalIgnoreCase)) ?? [];

    private static string SideText(ChangeSide side) => side switch
    {
        ChangeSide.Both => "Conflict",
        ChangeSide.Unknown => "",
        _ => side.ToString(),
    };

    private sealed class ChangeRow
    {
        public required string Type { get; init; }

        public required string Name { get; init; }

        public required string Change { get; init; }

        public ChangeSide Side { get; init; }

        public string? ChangedBy { get; init; }

        public string? Detail { get; init; }

        public string? File { get; init; }

        public bool IsData { get; init; }

        /// <summary>For a settings file, its diff from the last commit; null for objects and static data.</summary>
        public string? SettingsDiff { get; init; }

        public bool Selected { get; set; }

        public static ChangeRow For(ObjectChange change) => new()
        {
            Type = change.ObjectType,
            Name = change.Name,
            Change = change.Status.ToString(),
            Side = change.Side,
            ChangedBy = change.LastChange is { } last
                ? $"{last.LoginName} {last.StartTime.ToString("g", CultureInfo.CurrentCulture)}"
                : null,
            Detail = change.Children.Count == 0 ? null : string.Join(", ", change.Children.Select(c => $"{c.Status} {c.ObjectType} {c.Name}")),
            Selected = change.Side is not (ChangeSide.Folder or ChangeSide.Both) && change.Lock is not { Mine: false },
        };

        public static ChangeRow For(DataChange data) => new()
        {
            Type = "Static data",
            Name = data.Table,
            Change = string.Create(CultureInfo.InvariantCulture, $"{data.New} new, {data.Modified} modified, {data.Deleted} deleted rows"),
            File = data.File,
            IsData = true,
            Selected = true,
        };

        public static ChangeRow For(SettingsFileChange file) => new()
        {
            Type = "Settings file",
            Name = file.Path,
            Change = file.Change,
            File = file.Path,
            SettingsDiff = file.Diff,
            Selected = true,
        };
    }
}
