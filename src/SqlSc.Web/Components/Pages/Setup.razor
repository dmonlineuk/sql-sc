@page "/"
@inject UiState State

<PageTitle>sql-sc - Setup</PageTitle>

<section class="card">
    <h2>Working folder</h2>
    <label for="folder">Folder (the Redgate-style scripts folder in your git repository)</label>
    <input id="folder" type="text" @bind="folderInput" placeholder="C:\src\MyDatabase" />
    <div class="row">
        <button id="open-folder" @onclick="OpenFolder">Open</button>
        @if (folderError is not null)
        {
            <span class="error">@folderError</span>
        }
    </div>
    @if (links.Count > 0)
    {
        <label>Linked folders</label>
        <table class="grid">
            <thead><tr><th>Folder</th><th>Database</th><th>Mode</th><th>Authentication</th></tr></thead>
            <tbody>
                @foreach (var link in links)
                {
                    <tr class="@(IsCurrent(link) ? "selected" : null)" @onclick="() => Select(link.Folder)">
                        <td>@link.Folder</td>
                        <td>@ConnectionStrings.Describe(link.Connection)</td>
                        <td>@link.Mode</td>
                        <td>@ConnectionStrings.DescribeAuthentication(link.Connection)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@if (State.Folder is not null)
{
    <section class="card">
        <h2>Database for @State.Folder</h2>
        <label for="connection">Connection string</label>
        <input id="connection" type="text" @bind="connection" @bind:after="ConnectionEdited"
               placeholder="Server=myserver;Database=MyDb;Authentication=Active Directory Interactive;Encrypt=True" />
        <span class="muted">A password in the connection string is never saved.</span>
        @if (NeedsPassword)
        {
            <label for="password">Password for the SQL login</label>
            <input id="password" type="password" @bind="password" autocomplete="off"
                   placeholder="@(KnowsPassword ? "Already entered; sql-sc uses it until you close sql-sc ui" : null)" />
            <span class="muted">sql-sc never saves the password: it keeps it in memory until you close sql-sc ui. Click Connect and save to use it on the other pages.</span>
        }
        <label for="mode">Mode</label>
        <select id="mode" @bind="mode">
            <option value="@DatabaseMode.Shared">Shared - everyone develops on this database</option>
            <option value="@DatabaseMode.Dedicated">Dedicated - this is my own database</option>
        </select>
        <div class="row">
            <button id="test-connection" @onclick="TestConnection" disabled="@(busy || string.IsNullOrWhiteSpace(connection))">Test connection</button>
            <button id="save-link" class="primary" @onclick="ConnectAndSave" disabled="@(busy || string.IsNullOrWhiteSpace(connection))">Connect and save</button>
            @if (State.CurrentLink is not null)
            {
                <button id="remove-link" @onclick="RemoveLink" disabled="@busy">Remove link</button>
            }
            @if (busy)
            {
                <span class="muted">Connecting...</span>
            }
        </div>
        @if (message is not null)
        {
            <p class="@(failed ? "error" : "ok")">@message</p>
        }
    </section>
}

@code {
    private List<Link> links = [];
    private string? folderInput;
    private string? folderError;
    private string? connection;
    private string? password;
    private DatabaseMode mode = DatabaseMode.Shared;
    private bool busy;
    private string? message;
    private bool failed;

    private bool SavedLinkUnchanged => State.CurrentLink is { } link && !string.IsNullOrWhiteSpace(connection) && IsValid(connection) && SameConnection(link.Connection, connection);

    private bool KnowsPassword => SavedLinkUnchanged && State.HasPassword(State.CurrentLink!.Folder);

    private bool NeedsPassword => !string.IsNullOrWhiteSpace(connection) && IsValid(connection) && ConnectionStrings.NeedsPassword(connection);

    protected override void OnInitialized()
    {
        links = [.. State.Links.All()];
        folderInput = State.Folder;
        LoadLink();
    }

    private void OpenFolder() => Select(folderInput);

    private void Select(string? path)
    {
        folderError = null;
        message = null;
        if (string.IsNullOrWhiteSpace(path))
        {
            folderError = "Enter a folder.";
            return;
        }

        try
        {
            var full = Path.GetFullPath(path.Trim());
            WorkingFolder.Open(full);
            State.Folder = full;
            folderInput = full;
            LoadLink();
            State.NotifyChanged();
        }
        catch (Exception e) when (e is IOException or ArgumentException or InvalidDataException or UnauthorizedAccessException or NotSupportedException)
        {
            folderError = e.Message;
        }
    }

    private void LoadLink()
    {
        var link = State.CurrentLink;
        connection = link?.Connection;
        mode = link?.Mode ?? DatabaseMode.Shared;
        password = null;
    }

    private bool IsCurrent(Link link) => State.CurrentLink is { } current && current.Folder == link.Folder;

    private void ConnectionEdited() => message = null;

    /// <summary>Whether two connection strings are the same apart from any password.</summary>
    public static bool SameConnection(string saved, string edited) =>
        ConnectionStrings.WithoutPassword(saved, out _) == ConnectionStrings.WithoutPassword(edited, out _);

    private string? Effective()
    {
        if (string.IsNullOrWhiteSpace(connection) || !IsValid(connection))
        {
            Fail("That isn't a valid connection string.");
            return null;
        }

        return TypedPassword() is null && SavedLinkUnchanged
            ? State.ConnectionFor(State.CurrentLink!)
            : ConnectionStrings.WithPassword(connection, password ?? Environment.GetEnvironmentVariable(ConnectionStrings.PasswordVariable));
    }

    /// <summary>The password in the connection string, or else the one typed into the password box.</summary>
    private string? TypedPassword()
    {
        var inline = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connection).Password;
        return !string.IsNullOrEmpty(inline) ? inline : string.IsNullOrEmpty(password) ? null : password;
    }

    private async Task<ServerInfo?> Query(string effective, string? failurePrefix = null)
    {
        busy = true;
        message = null;
        try
        {
            return await State.RunAsync(() => ServerInfo.Query(effective));
        }
        catch (Exception e) when (e is Microsoft.Data.SqlClient.SqlException or InvalidOperationException or ArgumentException or AggregateException)
        {
            Fail(failurePrefix + e.Message);
            return null;
        }
        finally
        {
            busy = false;
        }
    }

    private static string Connected(ServerInfo info) =>
        $"Connected to {info.DatabaseName} on {info.ServerName} ({info.Platform}, {info.ProductVersion}).";

    private async Task TestConnection()
    {
        if (Effective() is not { } effective)
        {
            return;
        }

        var (saved, typed) = (SavedLinkUnchanged ? State.CurrentLink : null, TypedPassword());
        if (await Query(effective) is not { } info)
        {
            return;
        }

        var text = Connected(info);
        if (saved is null)
        {
            text += " Click Connect and save to use this connection on the other pages.";
        }
        else if (typed is not null)
        {
            State.RememberPassword(saved.Folder, typed);
            text += " sql-sc will use this password until you close sql-sc ui.";
            State.NotifyChanged();
        }

        failed = false;
        message = text;
    }

    private async Task ConnectAndSave()
    {
        if (State.Folder is not { } folder || Effective() is not { } effective)
        {
            return;
        }

        var (edited, unchanged, typed, linkMode) = (connection!, SavedLinkUnchanged, TypedPassword(), mode);
        if (await Query(effective, "The link wasn't saved, because sql-sc couldn't connect: ") is not { } info)
        {
            return;
        }

        var stored = ConnectionStrings.WithoutPassword(edited, out _);
        State.Links.Save(new Link(folder, stored, linkMode));
        if (State.CurrentLink is { } saved && (typed is not null || !unchanged))
        {
            State.RememberPassword(saved.Folder, typed);
        }

        links = [.. State.Links.All()];
        (connection, password, failed) = (stored, null, false);
        message = $"{Connected(info)} Link saved."
            + (typed is not null && ConnectionStrings.NeedsPassword(stored) ? " The password wasn't saved; sql-sc will use it until you close sql-sc ui." : string.Empty);
        State.NotifyChanged();
    }

    private void RemoveLink()
    {
        if (State.CurrentLink is { } link)
        {
            State.Links.Remove(link.Folder);
            State.RememberPassword(link.Folder, null);
        }

        links = [.. State.Links.All()];
        LoadLink();
        failed = false;
        message = "Link removed.";
        State.NotifyChanged();
    }

    private void Fail(string text)
    {
        failed = true;
        message = text;
    }

    private static bool IsValid(string value)
    {
        try
        {
            _ = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(value);
            return true;
        }
        catch (ArgumentException)
        {
            return false;
        }
    }
}
