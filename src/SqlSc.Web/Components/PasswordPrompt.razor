@inject UiState State

<div id="password-prompt" class="git-panel">
    <label for="session-password">@ConnectionStrings.PasswordPrompt(Link.Connection).TrimEnd(' ', ':')</label>
    <div class="row" style="margin-top:0">
        <input id="session-password" class="inline" type="password" @bind="password" @bind:event="oninput" @onkeydown="KeyDown" autocomplete="off" />
        <button id="session-connect" class="primary" @onclick="Connect" disabled="@(!CanConnect)">Connect</button>
        @if (busy)
        {
            <span class="muted">Connecting...</span>
        }
    </div>
    <span class="muted">This link uses a SQL login. sql-sc never saves the password: it keeps it in memory until you close sql-sc ui.</span>
    @if (error is not null)
    {
        <p class="error">@error</p>
    }
</div>

@code {
    private string? password;
    private bool busy;
    private string? error;

    [Parameter, EditorRequired] public Link Link { get; set; } = null!;

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnConnected { get; set; }

    private bool CanConnect => !busy && !Busy && !string.IsNullOrEmpty(password);

    private async Task KeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanConnect)
        {
            await Connect();
        }
    }

    private async Task Connect()
    {
        var typed = password!;
        var effective = ConnectionStrings.WithPassword(Link.Connection, typed);
        (busy, error) = (true, null);
        try
        {
            await State.RunAsync(() => ServerInfo.Query(effective));
        }
        catch (Exception e) when (e is Microsoft.Data.SqlClient.SqlException or InvalidOperationException or ArgumentException or AggregateException)
        {
            error = e.Message;
            return;
        }
        finally
        {
            busy = false;
        }

        State.RememberPassword(Link.Folder, typed);
        password = null;
        State.NotifyChanged();
        await OnConnected.InvokeAsync();
    }
}
